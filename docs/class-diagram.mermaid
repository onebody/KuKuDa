classDiagram
    %% 用户相关
    class User {
        +id: string
        +email: string
        +passwordHash: string
        +name: string
        +avatar: string?
        +role: UserRole
        +createdAt: DateTime
        +updatedAt: DateTime
        +workflows: Workflow[]
        +executions: Execution[]
    }

    class UserRole {
        <<enumeration>>
        USER
        ADMIN
        TEAM_ADMIN
    }

    %% 工作流相关
    class Workflow {
        +id: string
        +name: string
        +description: string?
        +userId: string
        +isTemplate: boolean
        +isPublic: boolean
        +thumbnail: string?
        +nodes: Node[]
        +connections: NodeConnection[]
        +executions: Execution[]
        +createdAt: DateTime
        +updatedAt: DateTime
        +lastExecutedAt: DateTime?
    }

    %% 节点相关
    class Node {
        +id: string
        +workflowId: string
        +type: NodeType
        +label: string
        +positionX: number
        +positionY: number
        +data: JSON
        +config: JSON
        +status: NodeStatus
        +result: JSON?
        +error: string?
        +executedAt: DateTime?
        +createdAt: DateTime
        +updatedAt: DateTime
    }

    class NodeType {
        <<enumeration>>
        TEXT_INPUT
        TEXT_OUTPUT
        LLM_CALL
        IMAGE_GENERATION
        IMAGE_INPUT
        FILE_INPUT
        CODE
        CONDITION
        LOOP
    }

    class NodeStatus {
        <<enumeration>>
        IDLE
        RUNNING
        SUCCESS
        ERROR
    }

    %% 节点连接
    class NodeConnection {
        +id: string
        +workflowId: string
        +sourceNodeId: string
        +sourceHandle: string
        +targetNodeId: string
        +targetHandle: string
        +createdAt: DateTime
    }

    %% 执行记录
    class Execution {
        +id: string
        +workflowId: string
        +userId: string
        +status: ExecutionStatus
        +triggeredBy: string
        +startedAt: DateTime
        +completedAt: DateTime?
        +error: string?
        +nodeResults: JSON
        +createdAt: DateTime
    }

    class ExecutionStatus {
        <<enumeration>>
        PENDING
        RUNNING
        SUCCESS
        FAILED
        CANCELLED
    }

    %% AI 模型适配器
    class AIModelAdapter {
        <<interface>>
        +modelType: string
        +execute(params: NodeData): Promise~NodeResult~
        +validateConfig(config: JSON): boolean
    }

    class OpenAIAdapter {
        +apiKey: string
        +model: string
        +execute(params): Promise~NodeResult~
    }

    class ClaudeAdapter {
        +apiKey: string
        +model: string
        +execute(params): Promise~NodeResult~
    }

    class WenxinAdapter {
        +apiKey: string
        +secretKey: string
        +execute(params): Promise~NodeResult~
    }

    class QwenAdapter {
        +apiKey: string
        +execute(params): Promise~NodeResult~
    }

    %% 关系
    User "1" --> "*" Workflow : 拥有
    User "1" --> "*" Execution : 触发
    Workflow "1" --> "*" Node : 包含
    Workflow "1" --> "*" NodeConnection : 包含
    Workflow "1" --> "*" Execution : 有
    Node "1" --> "*" NodeConnection : 作为源
    Node "1" --> "*" NodeConnection : 作为目标
    AIModelAdapter <|.. OpenAIAdapter : 实现
    AIModelAdapter <|.. ClaudeAdapter : 实现
    AIModelAdapter <|.. WenxinAdapter : 实现
    AIModelAdapter <|.. QwenAdapter : 实现
    Execution --> Workflow : 属于
